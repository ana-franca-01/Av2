# Copie para .env e ajuste. Valores abaixo são apenas para desenvolvimento local.
DATABASE_URL="postgresql://greencode:greencode@localhost:5433/greencode?schema=public"
# Banco usado pelo npm run test:e2e (schema separado, é apagado a cada execução)
DATABASE_URL_TESTE="postgresql://greencode:greencode@localhost:5433/greencode?schema=teste"

PORT=3000
HOST=0.0.0.0
# Gere um segredo forte em produção: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-este-segredo-de-desenvolvimento-por-um-valor-aleatorio"
JWT_EXPIRA_EM=30m
BCRYPT_CUSTO=12
LOG_LEVEL=info

# Senha do admin criado pelo seed (dev). Os demais usuários de teste usam SEED_SENHA_PADRAO.
SEED_SENHA_ADMIN="Admin@Green2026"
SEED_SENHA_PADRAO="Teste@Green2026"
